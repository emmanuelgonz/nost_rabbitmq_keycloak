## Custom location blocks for nost.smce.nasa.gov

# SOS application (disabled with the nost-sos service — re-enable together).
# Left active, nginx-proxy fails to start because it can't resolve nost-sos.
# location /sos/ {
#     proxy_pass http://nost-sos:3000/;
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }

# Monitor backend API
location /api/ {
    proxy_pass http://nost-monitor-backend:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Refresh-Token $http_x_refresh_token;
}

# Monitor frontend (default)
location / {
    proxy_pass http://nost-monitor-frontend:80/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Security headers
add_header X-Content-Type-Options nosniff;
add_header X-Frame-Options DENY;
add_header X-XSS-Protection "1; mode=block";
